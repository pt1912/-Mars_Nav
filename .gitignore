# ==========================================
# SCIENTIFIC DATA
# ==========================================

# MOLA — Original elevation datasets
# Large files (IMG, LBL) remain local
/data/raw/mola/

# HiRISE — Original terrain datasets
/data/raw/hirise/

# MOLA — Regional datasets
# Include regional DEM files for GitHub
!/data/processed/mola/

# Ignore other temporary processed data
/data/processed/*
!/data/processed/mola/

# SWIM4MIM — Scientific datasets
# Include both depth datasets and metadata
!/data/raw/swim/
!/data/raw/swim/manifest.json
!/data/raw/swim/swim_Ci_0_1.i8
!/data/raw/swim/swim_Ci_1_5.i8

# Geographic locations
!/data/locations/
!/data/locations/*.json


